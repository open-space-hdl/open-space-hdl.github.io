# Constraints of encrypted_spp_over_spw as the top level of the FPGA (or in a build of the system on its own): the
# clocks of its clock ports and the I/O registers. A design around the system creates its clocks and places its I/O
# registers itself and does not read this file. Pin locations and I/O standards belong to the board.

# Clocks
create_clock -period 10.000 -name Clk_sys [get_ports Clk_sys]
create_clock -period 5.000 -name Clk_link [get_ports Clk_link]

# Place the output flip-flops of data and strobe in the I/O blocks with matched routing.
set_property IOB TRUE [get_ports {spw0_Spw_DOut spw0_Spw_SOut}]
