# Timing exceptions of spp_over_spw_two_clocks, in terms of its ports and instances. Read the file scoped to the entity,
# alone or with the system inside a larger design: read_xdc -ref spp_over_spw_two_clocks spp_over_spw_two_clocks.xdc (in
# a project: set_property SCOPED_TO_REF spp_over_spw_two_clocks [get_files spp_over_spw_two_clocks.xdc]). The clocks
# come from the design around the system, or from spp_over_spw_two_clocks_top.xdc when the system is the top level.
#
# The reset input Rst needs no exception: every block that takes it releases it through olo_base_reset_gen, whose scoped
# constraints (the script of Open Logic, below) cut the paths into its synchronisers. The inputs that blocks synchronise
# themselves get a false path through the port, which holds whether the port is a device pin or the pin of the system
# inside a larger design.
#
# I/O registers: when the system is not the top level, place the output flip-flops of spw0_Spw_DOut, spw0_Spw_SOut in
# the I/O blocks at the pins of the top level (spp_over_spw_two_clocks_top.xdc does it when the system is the top
# level).

# Clocks
set clk_link [get_clocks -of_objects [get_ports Clk_link]]
set clk_spw  [get_clocks -of_objects [get_ports Clk_spw]]
set clk_sys  [get_clocks -of_objects [get_ports Clk_sys]]

# Inputs that spw0 synchronises itself.
set_false_path -through [get_ports {spw0_Spw_DIn spw0_Spw_SIn}]

# Clock crossings of spw0: the period of the faster clock.
set_max_delay -datapath_only -from $clk_link -to $clk_spw 5.000

# Clock crossings of spw0: the period of the faster clock.
set_max_delay -datapath_only -from $clk_spw -to $clk_link 5.000

# Clock crossings of auto_cdc_auto_ecc_c6, auto_cdc_c5, auto_cdc_c6: the period of the faster clock.
set_max_delay -datapath_only -from $clk_spw -to $clk_sys 10.000

# Clock crossings of auto_cdc_auto_ecc_c6, auto_cdc_c5, auto_cdc_c6: the period of the faster clock.
set_max_delay -datapath_only -from $clk_sys -to $clk_spw 10.000

