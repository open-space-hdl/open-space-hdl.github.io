#
# Timing exceptions of spacefibre_node, in terms of its ports and instances. Read the file scoped to the entity, alone
# or with the system inside a larger design: read_xdc -ref spacefibre_node spacefibre_node.xdc (in a project:
# set_property SCOPED_TO_REF spacefibre_node [get_files spacefibre_node.xdc]). The clocks come from the design around
# the system, or from spacefibre_node_top.xdc when the system is the top level.

# Clocks
set clk_lane [get_clocks -of_objects [get_pins i_pa0/LaneClk]]
set clk_sys  [get_clocks -of_objects [get_ports Clk_sys]]

# Asynchronous reset input; the reset generators synchronise its release.
set_false_path -from [get_ports Rst]

# Clock crossings of ofb0: the period of the faster clock.
set_max_delay -datapath_only -from $clk_lane -to $clk_sys 5.000

# Clock crossings of ofb0: the period of the faster clock.
set_max_delay -datapath_only -from $clk_sys -to $clk_lane 5.000

# AMD Vivado: source the script of Open Logic once. It reads the scoped constraints of olo_base_cc_reset,
# olo_base_cc_bits, olo_base_cc_simple, olo_base_reset_gen and olo_base_ram_sdp wherever the system uses them, also
# inside the cores. tools/vivado/all_constraints_amd.tcl would also read those of olo_intf_sync, which expect device
# pins at its input and stop the build (ERROR 18-513) where a block synchronises internal signals with it, as ofb_pa_gty
# does; a block that synchronises device pins declares its own false path for them. The script
# src/base/tcl/olo_base_constraints_amd.tcl is part of the Open Logic sources; add it to the project once (see the
# compile order).
